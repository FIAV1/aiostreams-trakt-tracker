{
  "name": "aiostreams-trakt-tracker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npx tsc",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiostreams/addon-sdk": "file:addon-sdk.tgz",
    "@fastify/cookie": "^11.1.5",
    "@fastify/env": "^6.0.0",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^11.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "sqlite3": true
  }
}
