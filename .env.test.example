# Copy to .env.test and fill these from your Trakt API app.
TRAKT_CLIENT_ID=replace_me
TRAKT_CLIENT_SECRET=replace_me

# Generate each key with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters
AIOSTREAMS_SECRET_KEY=replace_with_a_different_64_hex_character_key

# Optional; these ports are bound to host loopback only.
TRACKER_TEST_PORT=3001
AIOSTREAMS_TEST_PORT=3002
AIOSTREAMS_BASE_URL=http://localhost:3002
# Optionally pin a known AIOStreams image tag instead of latest.
# AIOSTREAMS_IMAGE=ghcr.io/viren070/aiostreams:<tag>
