NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Host-side binding for Docker Compose. Keep loopback unless another host needs access.
HOST_BIND_IP=127.0.0.1
HOST_PORT=3000

DATABASE_URL=./data/trakt-sync.db

TRAKT_CLIENT_ID=your_trakt_client_id
# Optional. PKCE authorization does not require this secret.
TRAKT_CLIENT_SECRET=
# Use a private HTTPS hostname that your browser can resolve and reach during sign-in.
TRAKT_REDIRECT_URI=https://trakt-sync.home.arpa/auth/callback

# Generate a 32-byte key (64 hex characters): openssl rand -hex 32
# Node.js alternative: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
PUBLIC_BASE_URL=https://trakt-sync.home.arpa

LOG_LEVEL=info
