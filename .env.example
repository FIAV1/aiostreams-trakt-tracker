NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Host-side binding for Docker Compose. Loopback is host-only; use a reachable private IP for another machine/container.
HOST_BIND_IP=127.0.0.1
HOST_PORT=3000

DATABASE_URL=./data/trakt-sync.db

TRAKT_CLIENT_ID=your_trakt_client_id
# Required by Trakt's device-code token exchange. Keep this server-side; never put it in AIOStreams.
TRAKT_CLIENT_SECRET=your_trakt_client_secret

# Generate a 32-byte key (64 hex characters): openssl rand -hex 32
# Node.js alternative: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

LOG_LEVEL=info
